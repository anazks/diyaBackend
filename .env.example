PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/until_we_meet_again

# Use a long random value
JWT_SECRET=

# true = no sign-in: anyone who can reach this server has full (admin) access.
# Keep false on a public server.
OPEN_ACCESS=false

# Family members need this code to create an account.
# The very first account needs no code and becomes the administrator.
FAMILY_INVITE_CODE=

# ImageKit (dashboard > Developer options). The private key must never reach the mobile app.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Optional, e.g. https://ik.imagekit.io/your_id (required only for a custom domain)
IMAGEKIT_URL_ENDPOINT=

# AWS S3 (older upload routes; optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_S3_PRESIGNED_EXPIRES_IN=3600
