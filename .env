PORT=5000
NODE_ENV=development

# MongoDB Connection String
# e.g., mongodb://localhost:27017/until_we_meet_again or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/until_we_meet_again

# JWT Secret for Session Management
JWT_SECRET=memorial_secret_key_until_we_meet_again_2026_sister_preservation

# AWS S3 Configuration (Private buckets & presigned URLs)
# If left blank, the server automatically uses local mock storage for media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=memorial-until-we-meet-again
AWS_S3_PRESIGNED_EXPIRES_IN=3600

# Memorial Configuration
MEMORIAL_NAME=Diya
MEMORIAL_DOB=-04-14
MEMORIAL_REST_DATE=2024-08-20
